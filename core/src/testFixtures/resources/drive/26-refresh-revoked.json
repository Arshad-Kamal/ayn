{
  "request": {
    "method": "POST",
    "url": "https://oauth2.googleapis.com/token",
    "headers": {
      "User-Agent": "Ayn (Android)",
      "Content-Type": "application/x-www-form-urlencoded"
    },
    "body": "client_id=CLIENT-ID.apps.googleusercontent.com&client_secret=CLIENT-SECRET&refresh_token=REFRESH-TOKEN&grant_type=refresh_token"
  },
  "response": {
    "code": 400,
    "headers": {
      "content-type": "application/json; charset=utf-8"
    },
    "body": "{\n  \"error\": \"invalid_grant\",\n  \"error_description\": \"Token has been expired or revoked.\"\n}"
  }
}
