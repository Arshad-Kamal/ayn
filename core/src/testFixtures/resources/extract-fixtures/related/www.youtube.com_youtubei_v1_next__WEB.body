enderer":{"style":"STYLE_BLUE_TEXT","size":"SIZE_DEFAULT","isDisabled":false,"text":{"runs":[{"text":"Unsubscribe"}]},"serviceEndpoint":{"clickTrackingParams":"COkBEPBbIhMIxKKbnZ6ulwMV79ktAB236DH3KPgdMgV3YXRjaMoBBEFEJkg=","commandMetadata":{"webCommandMetadata":{"sendPost":true,"apiUrl":"/youtubei/v1/subscription/unsubscribe"}},"unsubscribeEndpoint":{"channelIds":["UCHnyfMqiRRG1u-2MsSQLbXA"],"params":"CgIIAxILSnNCWk9jcVplcmsYAA%3D%3D"}},"accessibility":{"label":"Unsubscribe"},"trackingParams":"COkBEPBbIhMIxKKbnZ6ulwMV79ktAB236DH3"}},"cancelButton":{"buttonRenderer":{"style":"STYLE_TEXT","size":"SIZE_DEFAULT","isDisabled":false,"text":{"runs":[{"text":"Cancel"}]},"accessibility":{"label":"Cancel"},"trackingParams":"COgBEPBbIhMIxKKbnZ6ulwMV79ktAB236DH3"}},"primaryIsCancel":false}},"popupType":"DIALOG"}}]}}]}},"metadataRowContainer":{"metadataRowContainerRenderer":{"collapsedItemCount":0,"trackingParams":"COUBEM2rARgBIhMIxKKbnZ6ulwMV79ktAB236DH3"}},"showMoreText":{"simpleText":"...more"},"showLessText":{"simpleText":"Show less"},"trackingParams":"COUBEM2rARgBIhMIxKKbnZ6ulwMV79ktAB236DH3","defaultExpanded":false,"descriptionCollapsedLines":3,"showMoreCommand":{"clickTrackingParams":"COUBEM2rARgBIhMIxKKbnZ6ulwMV79ktAB236DH3ygEEQUQmSA==","commandExecutorCommand":{"commands":[{"clickTrackingParams":"COUBEM2rARgBIhMIxKKbnZ6ulwMV79ktAB236DH3ygEEQUQmSA==","changeEngagementPanelVisibilityAction":{"targetId":"engagement-panel-structured-description","visibility":"ENGAGEMENT_PANEL_VISIBILITY_EXPANDED"}},{"clickTrackingParams":"COUBEM2rARgBIhMIxKKbnZ6ulwMV79ktAB236DH3ygEEQUQmSA==","scrollToEngagementPanelCommand":{"targetId":"engagement-panel-structured-description"}}]}},"showLessCommand":{"clickTrackingParams":"COUBEM2rARgBIhMIxKKbnZ6ulwMV79ktAB236DH3ygEEQUQmSA==","changeEngagementPanelVisibilityAction":{"targetId":"engagement-panel-structured-description","visibility":"ENGAGEMENT_PANEL_VISIBILITY_HIDDEN"}},"attributedDescription":{"content":"How did Bletchley Park's codebreakers crack the \"unbreakable\" enigma? Sponsored by Incogni - use code veritasium at https://incogni.com/veritasium to get an exclusive 60% off your annual subscription.\n\nIf you’re looking for a molecular modelling kit, try Snatoms, a kit I invented where the atoms snap together magnetically - https://ve42.co/SnatomsV \n\nFor the latest science news, and for an exclusive bonus Q&A with the director of this video, sign up to the Veritasium newsletter - https://ve42.co/Newsletter \n\nFor early access to work in progress videos join our patreon https://ve42.co/VePatreon \n\n▀▀▀\n0:00 Who invented Enigma?\n4:16 How did Enigma work?\n10:51 The Secret Spy Mansion\n13:10 The First Codebreakers Who Broke Enigma\n16:45 Trying To Decrypt An Enigma Message\n22:35 Who was Alan Turing?\n26:30 How Enigma’s Flaws Were Exploited\n34:27 Breaking Enigma - The Bombe\n41:39 The Naval Enigma\n44:35 What did Alan Turing do after Bletchley Park? \n\n▀▀▀\nA huge thanks out to Sir Dermot Turing, Jonah Weinbaum, Andrew Fryer, John Pickles, Peter Hoath, Robert Dowell and all of the experts at Bletchley Park & The National Museum of Computing that helped make this video possible!\n\nShout out to Jared Owen for letting us use his 3D model of the Enigma machine! Check out his amazing video:    • How did the Enigma Machine work?  \n\nBletchley Park is a museum and heritage attraction open daily to visitors. To plan your visit and book tickets, head to: https://www.bletchleypark.org.uk/plan...\n\nThe National Museum of Computing at Bletchley Park is an independent charity housing working historic machines. Plan your visit here: https://www.tnmoc.org/plan-your-visit \n\n▀▀▀\nCan you decrypt this unbroken Naval Enigma message? Let us know in the comments!\n\nJCRSAJTGSJEYEXYKKZZSHVUOCTRFRCRPFVYPLKPPLGRHVVBBTBRSXSWXGGTYTVKQNGSCHVGF\n\nUniversal Enigma simulator by Daniel Palloks: https://ve42.co/EnigmaSim\n\n▀▀▀\nReferences: https://ve42.co/BletchleyRefs \n\nVisual References: https://ve42.co/BletchleyVisRefs \n\n▀▀▀\nSpecial thanks to our Patreon supporters:\nAdam Foreman, Albert Wenger, Alex Porter, Alexander Tamas, André Powell, Anton Ragin, Balkrishna Heroor, Bertrand Serlet, Blake Byers, Bruce, Bryan Ackermann, Chris Brewer, Data Don, Dave Kircher, David Johnston, David Tseng, EJ Alexandra, Evgeny Skvortsov, Garrett Mueller, Gnare, gpoly, Hayden Christensen, Hong Thai Le, Ibby Hadeed, Jeromy Johnson, Juan Benet, Kelcey Steele, Kyi, Lee Redden, Marinus Kuivenhoven, Mark Heising, Meekay, meg noah, Michael Krugman, Moebiusol - Cristian, Orlando Bassotto, Parsee Health, Patreon mp22, Paul Peijzel, Robson, Sam Lutfi, Shalva Bukia, Sinan Taifour, Steven, Sweet_Nemo, Tair Aurmont, Tj Steyn, Ubiquity Ventures, Vahe Andonians, wolfee\n\n\n▀▀▀\nWriters: James Moore, Gregor Čavlović, Darius Garewal & Emilia Gyles\nProducer & Director: James Moore\nAdditional Directing: Darius Garewal\nPresenters: Gregor Čavlović & Derek Muller\nEditor: Peter Nelson\nAdditional Editing: James Stuart & Trenton Oliver\nCamera Operators: Rob Newman & Darius Garewal\nAnimators: Emma Wright, Domonkos Józsa, Alex Drakoulis, Andrew Neet, Rokas Vikšraitis & Aleksandrs Loginovs\nIllustrator: Jakub Misiek\nResearchers: Darius Garewal & Gabe Strong\nThumbnail Designers: Abdallah Rabah, Daniel Ellacott & Ben Powell\nProduction Team: Jess Bishop-Laggett, Glen Griffiths, Matthew Cavanagh & Anna Milkovic\nExecutive Producers: Gregor Čavlović, Emilia Gyles, Henry van Dyck & Derek Muller\n\nAdditional video/photos supplied by Getty Images and Storyblocks\nMusic from Epidemic Sound \n& Sprach Zarathustra - Conducted by Philip Milman (https://pmmusic.pro/)","commandRuns":[{"startIndex":116,"length":30,"onTap":{"innertubeCommand":{"clickTrackingParams":"COUBEM2rARgBIhMIxKKbnZ6ulwMV79ktAB236DH3SLn15dScp5bgJsoBBEFEJkg=","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description&redir_token=QUZZTVljSHRxbTVoWjhyUHNSV0MzSHROanBpM3xBSTVJdTV2WmR6TDZjem5NdmhaSTBhVmVjWl