startIndex":808,"length":35,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":843,"length":5,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":848,"length":29,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":877,"length":5,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":882,"length":18,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":900,"length":5,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":905,"length":387,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1292,"length":39,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1331,"length":123,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1454,"length":40,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1494,"length":136,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1630,"length":37,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1667,"length":209,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1876,"length":25,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1901,"length":18,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1919,"length":29,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1948,"length":22,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1970,"length":32,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":2002,"length":1592,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":3594,"length":20,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":3614,"length":1,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"}],"backgroundColorStyle":"BACKGROUND_COLOR_STYLE_COLOR_SAMPLED","lightThemeColorPalette":{"baseBackground":4293982207,"raisedBackground":4293982207,"additiveBackground":558204105,"textPrimary":4278853430,"textSecondary":4282012526,"invertedBackground":4279849615,"overlayBackground":3423215414},"darkThemeColorPalette":{"baseBackground":4278325020,"raisedBackground":4278853430,"additiveBackground":725976265,"textPrimary":4292930810,"textSecondary":4289512413,"invertedBackground":4286361059,"overlayBackground":3423215414},"colorSampledDescriptionBodyText":{"content":"How did Bletchley Park's codebreakers crack the \"unbreakable\" enigma? Sponsored by Incogni - use code veritasium at https://incogni.com/veritasium to get an exclusive 60% off your annual subscription.\n\nIf you’re looking for a molecular modelling kit, try Snatoms, a kit I invented where the atoms snap together magnetically - https://ve42.co/SnatomsV \n\nFor the latest science news, and for an exclusive bonus Q&A with the director of this video, sign up to the Veritasium newsletter - https://ve42.co/Newsletter \n\nFor early access to work in progress videos join our patreon https://ve42.co/VePatreon \n\n▀▀▀\n0:00 Who invented Enigma?\n4:16 How did Enigma work?\n10:51 The Secret Spy Mansion\n13:10 The First Codebreakers Who Broke Enigma\n16:45 Trying To Decrypt An Enigma Message\n22:35 Who was Alan Turing?\n26:30 How Enigma’s Flaws Were Exploited\n34:27 Breaking Enigma - The Bombe\n41:39 The Naval Enigma\n44:35 What did Alan Turing do after Bletchley Park? \n\n▀▀▀\nA huge thanks out to Sir Dermot Turing, Jonah Weinbaum, Andrew Fryer, John Pickles, Peter Hoath, Robert Dowell and all of the experts at Bletchley Park & The National Museum of Computing that helped make this video possible!\n\nShout out to Jared Owen for letting us use his 3D model of the Enigma machine! Check out his amazing video:    • How did the Enigma Machine work?  \n\nBletchley Park is a museum and heritage attraction open daily to visitors. To plan your visit and book tickets, head to: https://www.bletchleypark.org.uk/plan...\n\nThe National Museum of Computing at Bletchley Park is an independent charity housing working historic machines. Plan your visit here: https://www.tnmoc.org/plan-your-visit \n\n▀▀▀\nCan you decrypt this unbroken Naval Enigma message? Let us know in the comments!\n\nJCRSAJTGSJEYEXYKKZZSHVUOCTRFRCRPFVYPLKPPLGRHVVBBTBRSXSWXGGTYTVKQNGSCHVGF\n\nUniversal Enigma simulator by Daniel Palloks: https://ve42.co/EnigmaSim\n\n▀▀▀\nReferences: https://ve42.co/BletchleyRefs \n\nVisual References: https://ve42.co/BletchleyVisRefs \n\n▀▀▀\nSpecial thanks to our Patreon supporters:\nAdam Foreman, Albert Wenger, Alex Porter, Alexander Tamas, André Powell, Anton Ragin, Balkrishna Heroor, Bertrand Serlet, Blake Byers, Bruce, Bryan Ackermann, Chris Brewer, Data Don, Dave Kircher, David Johnston, David Tseng, EJ Alexandra, Evgeny Skvortsov, Garrett Mueller, Gnare, gpoly, Hayden Christensen, Hong Thai Le, Ibby Hadeed, Jeromy Johnson, Juan Benet, Kelcey Steele, Kyi, Lee Redden, Marinus Kuivenhoven, Mark Heising, Meekay, meg noah, Michael Krugman, Moebiusol - Cristian, Orlando Bassotto, Parsee Health, Patreon mp22, Paul Peijzel, Robson, Sam Lutfi, Shalva Bukia, Sinan Taifour, Steven, Sweet_Nemo, Tair Aurmont, Tj Steyn, Ubiquity Ventures, Vahe Andonians, wolfee\n\n\n▀▀▀\nWriters: James Moore, Gregor Čavlović, Darius Garewal & Emilia Gyles\nProducer & Director: James Moore\nAdditional Directing: Darius Garewal\nPresenters: Gregor Čavlović & Derek Muller\nEditor: Peter Nelson\nAdditional Editing: James Stuart & Trenton Oliver\nCamera Operators: Rob Newman & Darius Garewal\nAnimators: Emma Wright, Domonkos Józsa, Alex Drakoulis, Andrew Neet, Rokas Vikšraitis & Aleksandrs Loginovs\nIllustrator: Jakub Misiek\nResearchers: Darius Garewal & Gabe Strong\nThumbnail Designers: Abdallah Rabah, Daniel Ellacott & Ben Powell\nProduction Team: Jess Bishop-Laggett, Glen Griffiths, Matthew Cavanagh & Anna Milkovic\nExecutive Producers: Gregor Čavlović, Emilia Gyles, Henry van Dyck & Derek Muller\n\nAdditional video/photos supplied by Getty Images and Storyblocks\nMusic from Epidemic Sound \n& Sprach Zarathustra - Conducted by Philip Milman (https://pmmusic.pro/)","commandRuns":[{"startIndex":116,"length":30,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBIQ040EGAYiEwjEopudnq6XAxXv2S0AHbfoMfdIufXl1JynluAmygEEQUQmSA==","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description&redir_token=QUZZTVljRVZubXJ5dDNkMlk5emdhTHltQTdidXxBSTVJdTV2QlZuSVJZQWswZ3JFWVlEOWtyTmttQnFma1kxQnVuaHhvdndMdHV5SlJDZzQ4NTB1RHNLUnVHQXRtRFpyZ0lib3dOQ3QwY1VGdXd3NktvblFKcW9VV1NLNkxuQWNv&q=https%3A%2F%2Fincogni.com%2Fveritasium&v=JsBZOcqZerk","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"https://www.youtube.com/redirect?event=video_description&redir_token=QUZZTVljRVZubXJ5dDNkMlk5emdhTHltQTdidXxBSTVJdTV2QlZuSVJZQWswZ3JFWVlEOWtyTmttQnFma1kxQnVuaHhvdndMdHV5SlJDZzQ4NTB1RHNLUnVHQXRtRFpyZ0lib3dOQ3QwY1VGdXd3NktvblFKcW9VV1NLNkxuQWNv&q=https%3A%2F%2Fincogni.com%2Fveritasium&v=JsBZOcqZerk","target":"TARGET_NEW_WINDOW","nofollow":true}}}},{"startIndex":326,"length":24,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBIQ040EGAYiEwjEopudnq6XAxXv2S0AHbfoMfdIufXl1JynluAmygEEQUQmSA==","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description&redir_token=QUZZTVljR29qOEcwNzBWLTJBY3Z6SFVsYjhhcHxBSTVJdTV1NGhSdWZmOG9tUC1HQ1d4RXQ1WnZoWG9Td0xYYjc2YW1sdUZER1dLZVh2REJFTlBHQWNtN3VwMmg0Q3puQzU3SXB5bFBPdzM2a3d0ZkZTU1owZHZfQnU5YkxUZTFV&q=https%3A%2F%2Fve42.co%2FSnatomsV&v=JsBZOcqZerk","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"https://www.youtube.com/redirect?event=video_description&redir_token=QUZZTVljR29qOEcwNzBWLTJBY3Z6SFVsYjhhcHxBSTVJdTV1NGhSdWZmOG9tUC1HQ1d4RXQ1WnZoWG9Td0xYYjc2YW1sdUZER1dLZVh2REJFTlBHQWNtN3VwMmg0Q3puQzU3SXB5bFBPdzM2a3d0ZkZTU1owZHZfQnU5YkxUZTFV&q=https%3A%2F%2Fve42