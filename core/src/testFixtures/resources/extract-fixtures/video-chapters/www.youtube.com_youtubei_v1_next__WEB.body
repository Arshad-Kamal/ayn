 2026"},"factoid":[{"factoidRenderer":{"value":{"simpleText":"121k"},"label":{"simpleText":"Likes"},"accessibilityText":"121 thousand likes","backgroundColorStyle":"BACKGROUND_COLOR_STYLE_COLOR_SAMPLED","lightThemeColorPalette":{"baseBackground":4294965232,"raisedBackground":4294965232,"additiveBackground":566854213,"textPrimary":4281736714,"textSecondary":4285420090,"invertedBackground":4287581977,"overlayBackground":3426098698},"darkThemeColorPalette":{"baseBackground":4280028674,"raisedBackground":4281736714,"additiveBackground":734626373,"textPrimary":4294634720,"textSecondary":4292723372,"invertedBackground":4293111164,"overlayBackground":3426098698},"enableColorSampledText":true}},{"viewCountFactoidRenderer":{"viewCountEntityKey":"EgtKc0JaT2NxWmVyayDCASgB","factoid":{"factoidRenderer":{"value":{"simpleText":"15,426,469"},"label":{"simpleText":"Views"},"accessibilityText":"15,426,469 views","backgroundColorStyle":"BACKGROUND_COLOR_STYLE_COLOR_SAMPLED","lightThemeColorPalette":{"baseBackground":4294965232,"raisedBackground":4294965232,"additiveBackground":566854213,"textPrimary":4281736714,"textSecondary":4285420090,"invertedBackground":4287581977,"overlayBackground":3426098698},"darkThemeColorPalette":{"baseBackground":4280028674,"raisedBackground":4281736714,"additiveBackground":734626373,"textPrimary":4294634720,"textSecondary":4292723372,"invertedBackground":4293111164,"overlayBackground":3426098698},"enableColorSampledText":true}},"viewCountType":"VIEW_COUNT_FACTOID_TYPE_TOTAL_VIEWS"}},{"factoidRenderer":{"value":{"simpleText":"21 Sept"},"label":{"simpleText":"2026"},"accessibilityText":"21 Sept 2026","backgroundColorStyle":"BACKGROUND_COLOR_STYLE_COLOR_SAMPLED","lightThemeColorPalette":{"baseBackground":4294965232,"raisedBackground":4294965232,"additiveBackground":566854213,"textPrimary":4281736714,"textSecondary":4285420090,"invertedBackground":4287581977,"overlayBackground":3426098698},"darkThemeColorPalette":{"baseBackground":4280028674,"raisedBackground":4281736714,"additiveBackground":734626373,"textPrimary":4294634720,"textSecondary":4292723372,"invertedBackground":4293111164,"overlayBackground":3426098698},"position":"FACTOID_POSITION_LAST","enableColorSampledText":true}}],"channelNavigationEndpoint":{"clickTrackingParams":"CBEQ040EGAYiEwjesZ6J456XAxVziooHHbi1Ms3KAQT1AK1L","commandMetadata":{"webCommandMetadata":{"url":"/@veritasium","webPageType":"WEB_PAGE_TYPE_CHANNEL","rootVe":3611,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"UCHnyfMqiRRG1u-2MsSQLbXA","canonicalBaseUrl":"/@veritasium"}},"channelThumbnail":{"thumbnails":[{"url":"https://yt3.ggpht.com/7vCbvtCqtjQ3YLgsJt7Y952MQV1sBvhllSCSxHP8_sVZdcPCBrITfhkN2RdyCuwPnsByq-1GoA=s88-c-k-c0x00ffffff-no-rj"}]}}},{"expandableVideoDescriptionBodyRenderer":{"showMoreText":{"accessibility":{"accessibilityData":{"label":"Show more"}},"simpleText":"...more"},"showLessText":{"simpleText":"Show less"},"attributedDescriptionBodyText":{"content":"How was the \"unbreakable\" enigma cracked? Sponsored by Incogni - use code veritasium at https://incogni.com/veritasium to get an exclusive 60% off your annual subscription.\n\nIf you’re looking for a molecular modelling kit, try Snatoms, a kit I invented where the atoms snap together magnetically - https://ve42.co/SnatomsV \n\nFor the latest science news, and for an exclusive bonus Q&A with the director of this video, sign up to the Veritasium newsletter - https://ve42.co/Newsletter \n\nFor early access to work in progress videos join our patreon https://ve42.co/VePatreon \n\n▀▀▀\n0:00 Who invented Enigma?\n4:16 How did Enigma work?\n10:51 The Secret Spy Mansion\n13:10 The First Codebreakers Who Broke Enigma\n16:45 Trying To Decrypt An Enigma Message\n22:35 Who was Alan Turing?\n26:30 How Enigma’s Flaws Were Exploited\n34:27 Breaking Enigma - The Bombe\n41:39 The Naval Enigma\n44:35 What did Alan Turing do after Bletchley Park? \n\n▀▀▀\nA huge thanks out to Sir Dermot Turing, Jonah Weinbaum, Andrew Fryer, John Pickles, Peter Hoath, Robert Dowell and all of the experts at Bletchley Park & The National Museum of Computing that helped make this video possible!\n\nShout out to Jared Owen for letting us use his 3D model of the Enigma machine! Check out his amazing video:    • How did the Enigma Machine work?  \n\nBletchley Park is a museum and heritage attraction open daily to visitors. To plan your visit and book tickets, head to: https://www.bletchleypark.org.uk/plan...\n\nThe National Museum of Computing at Bletchley Park is an independent charity housing working historic machines. Plan your visit here: https://www.tnmoc.org/plan-your-visit \n\n▀▀▀\nCan you decrypt this unbroken Naval Enigma message? Let us know in the comments!\n\nJCRSAJTGSJEYEXYKKZZSHVUOCTRFRCRPFVYPLKPPLGRHVVBBTBRSXSWXGGTYTVKQNGSCHVGF\n\nUniversal Enigma simulator by Daniel Palloks: https://ve42.co/EnigmaSim\n\n▀▀▀\nReferences: https://ve42.co/BletchleyRefs \n\nVisual References: https://ve42.co/BletchleyVisRefs \n\n▀▀▀\nSpecial thanks to our Patreon supporters:\nAdam Foreman, Albert Wenger, Alex Porter, Alexander Tamas, André Powell, Anton Ragin, Balkrishna Heroor, Bertrand Serlet, Blake Byers, Bruce, Bryan Ackermann, Chris Brewer, Data Don, Dave Kircher, David Johnston, David Tseng, EJ Alexandra, Evgeny Skvortsov, Garrett Mueller, Gnare, gpoly, Hayden Christensen, Hong Thai Le, Ibby Hadeed, Jeromy Johnson, Juan Benet, Kelcey Steele, Kyi, Lee Redden, Marinus Kuivenhoven, Mark Heising, Meekay, meg noah, Michael Krugman, Moebiusol - Cristian, Orlando Bassotto, Parsee Health, Patreon mp22, Paul Peijzel, Robson, Sam Lutfi, Shalva Bukia, Sinan Taifour, Steven, Sweet_Nemo, Tair Aurmont, Tj Steyn, Ubiquity Ventures, Vahe Andonians, wolfee\n\n\n▀▀▀\nWriters: James Moore, Gregor Čavlović, Darius Garewal & Emilia Gyles\nProducer & Director: James Moore\nAdditional Directing: Darius Garewal\nPresenters: Gregor Čavlović & Derek Muller\nEditor: Peter Nelson\nAdditional Editing: James Stuart & Trenton Oliver\nCamera Operators: Rob Newman & Darius Garewal\nAnimators: Emma Wright, Domonkos Józsa, Alex Drakoulis, Andrew Neet, Rokas Vikšraitis & Aleksandrs Loginovs\nIllustrator: Jakub Misiek\nResearchers: Darius Garewal & Gabe Strong\nThumbnail Designers: Abdallah Rabah, Daniel Ellacott & Ben Powell\nProduction Team: Jess Bishop-Laggett, Glen Griffiths, Matthew Cavanagh & Anna Milkovic\nExecutive Producers: Gregor Čavlović, Emilia Gyles, Henry van Dyck & Derek Muller\n\nAdditional video/photos supplied by Getty Images and Storyblocks\nMusic from Epidemic Sound \n& Sprach Zarathustra - Conducted by Philip Milman (https://pmmusic.pro/)","commandRuns":[{"startIndex":88,"length":30,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBEQ040EGAYiEwjesZ6J456XAxVziooHHbi1Ms1IufXl1JynluAmygEE9QCtSw==","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description&redir_token=QUZZTVljRWZZY0QtM1Z6SWhreTQ1VE1kSDVpc3xBTl9pYzRla2NRNU9KQW5sQjNSSVdDSnh1bFpOZWdoZWFtQlpISjR5ZlIyVU1Sd2VzZ1oyQzFIWHNoRUVrUl9xV1JYVVVxbzY1SV9fOTZUMW9DWlZneE9DV2lNdmhoTWJWVEtn&q=https%3A%2F%2Fincogni.com%2Fveritasium&v=JsBZOcqZerk","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"https://www.youtube.com/redirect?event=video_description&redir_token=QUZZTVljRWZZY0QtM1Z6SWhreTQ1VE1kSDVpc3xBTl9pYzRla2NRNU9KQW5sQjNSSVdDSnh1bFpOZWdoZWFtQlpISjR5ZlIyVU1Sd2VzZ1oyQzFIWHNoRUVrUl9xV1JYVVVxbzY1SV9fOTZUMW9DWlZneE9DV2lNdmhoTWJWVEtn&q=https%3A%2F%2Fincogni.com%2Fveritasium&v=JsBZOcqZerk","target":"TARGET_NEW_WINDOW","nofollow":true}}}},{"startIndex":298,"length":24,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBEQ040EGAYiEwjesZ6J456XAxVziooHHbi1Ms1IufXl1JynluAmygEE9QCtSw==","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description&redir_token=QUZZTVljRkhma2kzSjdFTldwS1lUV0xxa3F3ZnxBTl9pYzRlUEhfQTcyTXRhTWpnWVZob1V5YzdjeHRSd3hCLWFnTUFNcjd2MHMzR1pEVHMtTDJTQ29qYTNLUW9sNVJSd2NLSkdNWDZnR3k3d2dUYXRmTDJaS1FIa3d3OFpRclR3&q=http